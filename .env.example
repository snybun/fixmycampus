# ==============================================================================
# FixMyCampus Environment Configuration
# Tagline: "Report. Track. Improve."
# ==============================================================================

# Application Settings
APP_NAME=FixMyCampus
APP_TAGLINE="Report. Track. Improve."
APP_ENV=development
APP_DEBUG=true
APP_URL=http://localhost:8080
APP_PORT=8080

# Database Configuration (MySQL 8)
# When running inside Docker, DB_HOST should be 'database' (the service name).
# For host tools (e.g. DBeaver/Workbench), connect to 127.0.0.1:3306.
DB_HOST=database
DB_PORT=3306
DB_DATABASE=fixmycampus_db
DB_USERNAME=fmc_user
DB_PASSWORD=fmc_secure_password_2026
DB_ROOT_PASSWORD=fmc_root_secret_2026

# phpMyAdmin Settings
PMA_PORT=8081
PMA_UPLOAD_LIMIT=64M
